# Copy to .env and adjust:  cp .env.example .env
# Values below are local-development placeholders only.

# ----- PostgreSQL + pgvector -----
DB_HOST=db
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=change-me

# ----- Redis (task queue) -----
REDIS_HOST=redis-queue

# ----- MinIO (object storage for uploaded PDFs) -----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_BUCKET=documents

# ----- API gateway -----
API_PORT=8000
LOG_LEVEL=INFO

# ----- Retrieval / embedding (gateway and worker MUST use the same model) -----
EMBEDDING_MODEL=BAAI/bge-m3
SIMILARITY_THRESHOLD=0.4
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ----- LLM (Ollama running on the host machine) -----
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT=120

# ----- Frontend (URL the browser uses to reach the API) -----
VITE_API_URL=http://localhost:8000

# Retrieval
RETRIEVAL_MODE=hybrid
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_BY_DEFAULT=false

# Agent
AGENT_MAX_STEPS=8
QUERY_EXPANSION=true
